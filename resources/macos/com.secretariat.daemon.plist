<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Label: Unique identifier for the launch agent -->
    <key>Label</key>
    <string>com.secretariat.daemon</string>

    <!-- ProgramArguments: Path to the daemon binary -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/secd</string>
    </array>

    <!-- RunAtLoad: Start the daemon when the user logs in -->
    <key>RunAtLoad</key>
    <true/>

    <!-- KeepAlive: Restart the daemon if it crashes -->
    <key>KeepAlive</key>
    <dict>
        <!-- Only restart if it exits with a non-zero exit code -->
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <!-- ProcessType: Mark as background process -->
    <key>ProcessType</key>
    <string>Background</string>

    <!-- WorkingDirectory: Where the daemon runs from -->
    <key>WorkingDirectory</key>
    <string>/tmp</string>

    <!-- StandardOutPath: Log stdout to file -->
    <key>StandardOutPath</key>
    <string>/tmp/secretariat-daemon.log</string>

    <!-- StandardErrorPath: Log stderr to file -->
    <key>StandardErrorPath</key>
    <string>/tmp/secretariat-daemon.error.log</string>

    <!-- EnvironmentVariables: Set environment for the daemon -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>RUST_LOG</key>
        <string>info</string>
    </dict>

    <!-- ThrottleInterval: Wait at least 10 seconds between restarts -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <!-- Nice: Run at normal priority -->
    <key>Nice</key>
    <integer>0</integer>

    <!-- LowPriorityIO: Don't compete with user I/O -->
    <key>LowPriorityIO</key>
    <true/>
</dict>
</plist>
